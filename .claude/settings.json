{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(node scripts/*)",
      "Bash(node ./scripts/*)",
      "Bash(node .claude/scripts/*)",
      "Bash(node ./.claude/scripts/*)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git fetch *)",
      "PowerShell(git branch *)",
      "PowerShell(git switch *)",
      "PowerShell(git checkout -b *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git merge *)",
      "PowerShell(git pull *)",
      "PowerShell(git push *)",
      "PowerShell(node scripts/*)",
      "PowerShell(node ./scripts/*)",
      "PowerShell(node .claude/scripts/*)",
      "PowerShell(node ./.claude/scripts/*)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(rm -r *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -R *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Bash(rm --recursive *)",
      "Bash(rm * -r *)",
      "Bash(rm * -rf *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git reset * --hard*)",
      "PowerShell(Remove-Item *-Rec*)",
      "PowerShell(Remove-Item -r *)",
      "PowerShell(Remove-Item * -r *)",
      "PowerShell(Remove-Item * -r)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  }
}
